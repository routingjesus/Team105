# --- Frontend (Next.js) -----------------------------------------------------

# Base URL the wizard prepends to its `/api/...` calls, inlined into the client
# bundle at `next build` time (set it BEFORE building, not after).
#
# Proxy mode (recommended, and what `scripts/run-local.ps1` uses): leave this
# EMPTY. The client then issues same-origin relative requests (e.g.
# `/api/trucks/generate`) that flow through the Next.js rewrite below — no CORS,
# works behind a tunnel or on a teammate's machine with no backend edits.
#
# Direct mode: set an absolute origin to bypass the proxy and hit the API
# directly (that origin must be in the backend's WIZARD_ALLOWED_ORIGINS), e.g.
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=

# --- Proxy target (server-side, build/dev-time only) ------------------------

# Where the Next.js server forwards `/api/*` in proxy mode. The launcher sets
# this to the API port it actually bound. Defaults to http://127.0.0.1:8080
# when unset. Not exposed to the browser (no NEXT_PUBLIC_ prefix).
# API_PROXY_TARGET=http://127.0.0.1:8080

# --- Backend (FastAPI) — Trimble geocoding (SPEC-017) -----------------------

# Trimble Maps Single Search API key. Server-side only — never expose to the
# browser or commit a real value. Required for "Look up coordinates" in the
# wizard; manual lat/long entry still works when unset.
# TRIMBLE_MAPS_API_KEY=

# Single Search region segment (default: na). Must match your key's license.
# TRIMBLE_SINGLESEARCH_REGION=na
